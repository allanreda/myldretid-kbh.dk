{
  "hosting": [
    {
      "target": "prod",
      "public": "website",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "https://myldretid-kbh.dk",
          "type": 301
        },
        {
          "source": "/**",
          "destination": "https://myldretid-kbh.dk",
          "type": 301
        }
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "dev",
      "public": "website",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
